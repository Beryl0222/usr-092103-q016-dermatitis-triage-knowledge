{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "虫媒皮炎分流知识台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "KNOWLEDGE_PUBLISHED",
        "CONSULTATION_ASSESSED",
        "CASE_ESCALATED",
        "CLUSTER_REVIEWED",
        "CONTENT_WITHDRAWN"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "knowledge_revision",
        "consultation_case",
        "risk_signal",
        "channel_release"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
